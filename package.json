{
  "name": "igcp-aforro",
  "version": "2026.513.0",
  "description": "TypeScript library and CLI for simulating Portuguese IGCP Aforro Treasury Certificates (Séries C, D, E, and F): deterministic quarterly compounding with Euribor 3M-derived base rates and permanence-tier premiums.",
  "license": "MIT",
  "author": "Pedro Primor <pedro.primor@pm.me>",
  "homepage": "https://github.com/pprimor/igcp-aforro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pprimor/igcp-aforro.git"
  },
  "bugs": {
    "url": "https://github.com/pprimor/igcp-aforro/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./api/handlers": {
      "types": "./src/api/handlers.ts",
      "import": "./src/api/handlers.ts",
      "default": "./src/api/handlers.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aforro": "dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "fetch:euribor": "tsx scripts/fetch-euribor.ts",
    "fetch:igcp-base-rates": "tsx scripts/fetch-igcp-base-rates.ts",
    "build:rates-json": "tsx scripts/build-rates-json.ts",
    "build:worker": "pnpm --filter igcp-aforro-api build",
    "deploy:api": "pnpm --filter igcp-aforro-api deploy",
    "dev:api": "pnpm --filter igcp-aforro-api dev",
    "dev:mcp": "pnpm --filter igcp-aforro-mcp dev",
    "compare:igcp": "tsx compare/igcp-simulator.ts",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build"
  },
  "keywords": [
    "igcp",
    "aforro",
    "portugal",
    "treasury",
    "certificates",
    "euribor",
    "serie-d",
    "serie-e",
    "serie-f",
    "finance",
    "simulator"
  ],
  "dependencies": {
    "big.js": "^6.2.2",
    "cac": "^6.7.14",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "msw"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/big.js": "^6.2.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.9",
    "execa": "^9.5.2",
    "fast-check": "^3.23.2",
    "msw": "^2.6.6",
    "node-html-parser": "^7.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
